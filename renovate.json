{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "rangeStrategy": "update-lockfile",
  "prHourlyLimit": 1,
  "minimumReleaseAge": "1 day",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "groupName": "Platformatic packages",
      "matchPackageNames": [
        "@platformatic/*"
      ],
      "minimumReleaseAge": null
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "timezone": "Europe/Rome",
  "schedule": [
    "* 0-6 * * 6,0"
  ],
  "rebaseWhen": "conflicted"
}

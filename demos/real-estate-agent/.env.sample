# Copy to .env to override the defaults. All values are optional:
# with no keys set, the demo runs fully offline on eve's mockModel().

# --- Model selection (pick at most one auth path) ---

# 1) Vercel AI Gateway (one key, any provider). Also satisfied by `vercel link`.
# AI_GATEWAY_API_KEY=

# 2) A provider directly, bypassing the gateway.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Override the model id used by whichever path is active.
#   gateway form:  provider/model  (e.g. anthropic/claude-sonnet-5)
#   direct form:   model           (e.g. claude-sonnet-5, gpt-5.4-mini)
# EVE_MODEL=anthropic/claude-sonnet-5
